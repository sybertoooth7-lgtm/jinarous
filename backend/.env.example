# Database
DATABASE_URL=postgresql://alux:password@localhost:5432/alux_plaza
DB_SSL=false

# CORS
CORS_ORIGIN=https://yourdomain.com

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=you@example.com

# Monitoring
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Cluster
CLUSTER_MODE=true

# Redis (required for adaptive rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=          # leave empty if no auth
REDIS_DB=0

# Rate limiting
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# JWT
JWT_SECRET=your-64-char-random-secret-here-change-me
JWT_EXPIRES_IN=2h

# Node env
NODE_ENV=production      # in prod, cookies become Secure
