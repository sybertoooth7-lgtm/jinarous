# Server
PORT=4000
NODE_ENV=production

# CORS - the origin(s) your frontend is served from, comma separated
CORS_ORIGIN=http://localhost:5173

# SQLite database file location
DB_PATH=./data/alux.db

# JWT secret used to sign admin session tokens - generate a long random string
# e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# How many contact submissions a single IP can send per window
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5
