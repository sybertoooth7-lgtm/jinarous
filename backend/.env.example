# Server
PORT=4000
NODE_ENV=production

# CORS - the origin(s) your frontend is served from, comma separated
CORS_ORIGIN=http://localhost:5173

# SQLite database file location
DB_PATH=./data/alux.db

# JWT secret used to sign admin session tokens - generate a long random string
# e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# How many contact submissions a single IP can send per window
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# --- Monitoring & error tracking (all optional) ---

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional: paste a Sentry DSN to send exceptions to Sentry.
# Leave blank to skip Sentry entirely (errors still get logged locally either way).
SENTRY_DSN=

# Optional: a Slack or Discord "incoming webhook" URL. When set, the server
# posts a one-line alert there on unhandled errors and crashes (throttled to
# once per 5 minutes per error type, so it can't spam the channel).
ALERT_WEBHOOK_URL=
