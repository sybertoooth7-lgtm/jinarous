# Server
PORT=4000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://alux:password@localhost:5432/alux_plaza
DB_SSL=false

# CORS
CORS_ORIGIN=https://yourdomain.com

# JWT
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h

# Rate Limiting
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=you@example.com

# Monitoring
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Cluster
CLUSTER_MODE=true
