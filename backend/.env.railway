# Railway Environment Configuration
# Copy these variables to your Railway project settings.
# This must match src/config.js and src/db.js exactly, or the server
# refuses to boot (see the startup checks in src/config.js).

# Server
PORT=8080
NODE_ENV=production

# Database — Postgres is required, not SQLite. If you add a Railway
# Postgres plugin, Railway auto-injects DATABASE_URL for you; otherwise
# set it to your hosted Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/alux_plaza
DB_SSL=true

# CORS - set this to your deployed frontend's URL (comma-separate multiple
# origins if needed). Must include the scheme (https://) or the server
# refuses to start.
# Example: https://alux-plaza.vercel.app
CORS_ORIGIN=https://your-frontend-domain.com

# JWT secret - generate a strong random string (32+ chars)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-random-jwt-secret-here
JWT_EXPIRES_IN=8h

# Rate limiting
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# Email notifications (Resend) — optional; contact form still saves to the
# DB without these, it just won't email you about new submissions.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=you@example.com

# --- Monitoring & error tracking (all optional) ---

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Optional: Slack or Discord webhook URL for alerts
ALERT_WEBHOOK_URL=

# Set to true only if you also provision more CPU/memory on Railway —
# each cluster worker opens its own Postgres connection pool (up to 20
# connections), so this can exhaust a free-tier Postgres connection limit
# fast if left on with a small plan.
CLUSTER_MODE=false
