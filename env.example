# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string-minimum
JWT_EXPIRES_IN=8h

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Cluster Mode
CLUSTER_MODE=false
WORKERS=4

# Redis (required for cluster-safe rate limiting)
REDIS_URL=redis://localhost:6379
